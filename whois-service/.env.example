# Pin the tag CI produced (commit SHA). `latest` works but makes rollbacks guesswork.
WHOIS_IMAGE_TAG=latest
DATABASE_URL=postgresql+psycopg://whois:CHANGE_ME@postgres:5432/whois_db

# API
AKV_WHOIS_API_KEY=                 # comma-separate two keys while rotating
ADMIN_ALLOWED_GROUPS=platform-admins
ADMIN_PROXY_SHARED_SECRET=         # openssl rand -hex 32

# Worker (app registration with User.Read.All + GroupMember.Read.All, application, admin-consented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
